# VeriFlow Deployment Environment Variables
# Copy this file to .env and fill in your values

# Required for deployment to Monad testnet
# Private key of the deployer wallet (WITHOUT 0x prefix)
PRIVATE_KEY=your_private_key_here

# Monad Testnet RPC URL (Chain ID: 10143)
# Get from: https://docs.monad.xyz or your RPC provider
MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz

# Optional: WETH address on Monad testnet (if already deployed)
# Leave empty to deploy mock WETH locally
WETH_ADDRESS=

# Optional: Governor address for contract ownership (defaults to deployer)
GOVERNOR=

# Optional: Existing CVI Registry address (leave empty to deploy mock)
CVI_REGISTRY_ADDRESS=

# Optional: Existing CVA Registry address (leave empty to deploy mock)
CVA_REGISTRY_ADDRESS=

# Optional: Deploy test tokens (TKA, TKB) for local testing
# Set to "true" to deploy mock tokens and register them in CVA registry
DEPLOY_TEST_TOKENS=false

# Optional: Deployer private key for governor (if different from PRIVATE_KEY)
DEPLOYER_PRIVATE_KEY=

# --- BootstrapVeriFlow.s.sol ---
# Stack addresses default to the LATEST DeployVeriFlow broadcast JSON
# (broadcast/DeployVeriFlow.s.sol/<chainId>/run-latest.json) — NEW-05.
# Set any of these to override a specific address.
VERI_FACTORY=
VERI_ROUTER=
CVI_REGISTRY=
CVA_REGISTRY=
COMPLIANCE_HOOK=

# Tokens used by the bootstrap (defaults: canonical Monad testnet WMON/USDC)
WMON=
USDC=

# SEED_LIQUIDITY=true: governor mints/wraps tokens and adds initial liquidity
# (defaults 100 WMON : 10,000 USDC — override with SEED_WMON / SEED_USDC).
SEED_LIQUIDITY=false
SEED_WMON=100000000000000000000
SEED_USDC=10000000000

# NEW-09 + NEW-14: factory feeToSetter. Comes from env; when UNSET it defaults
# to the GOVERNOR key (never an anvil default account — the deploy/bootstrap
# scripts assert this and revert if feeToSetter is one of the 10 anvil keys).
FEE_TO_SETTER=