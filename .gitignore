# ── Environment / secrets ──────────────────────────────────────────
# Never commit .env files (they hold private keys + API credentials).
.env
.env.*
!.env.example
!**/.env.example

# ── Foundry / Forge ────────────────────────────────────────────────
# Build artifacts
contracts/out/
contracts/cache/

# Deployment broadcast artifacts — these can contain transaction data,
# deployed addresses, and (in the sensitive-values cache) private keys.
contracts/broadcast/

# ── Frontend ───────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Editor / OS ────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Claude Code local skills (not part of the VeriFlow repo) ───────
.claude/
